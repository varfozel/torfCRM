# Application Settings
PROJECT_NAME="Peat CRM"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Web Service Ports (mapped on 127.0.0.1 to avoid VPS conflicts)
APP_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Manager Web Panel Authentication
MANAGER_USERNAME=admin
MANAGER_PASSWORD=peat_manager_2026
JWT_SECRET_KEY=change_this_to_a_random_secure_jwt_secret_key_2026

# Database Configuration (PostgreSQL container & connection URL)
POSTGRES_USER=peat_user
POSTGRES_PASSWORD=change_this_to_secure_password
POSTGRES_DB=peat_crm
DATABASE_URL=postgresql+asyncpg://peat_user:change_this_to_secure_password@postgres:5432/peat_crm

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ_example
# Optional: comma-separated list of Telegram user IDs permitted to use the bot. Leave empty to allow any user.
TELEGRAM_ALLOWED_USER_IDS=

# Warehouse Origin Configuration (Fixed dispatch location)
WAREHOUSE_NAME="Маневицький склад торфу"
WAREHOUSE_ADDRESS="смт Маневичі, Волинська область, Україна"
WAREHOUSE_LAT=51.298100
WAREHOUSE_LON=25.553200
